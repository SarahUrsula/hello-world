# ── Notification settings (at least one required) ──────────────────────────────

# Email via SMTP (Gmail: use an App Password, not your real password)
EMAIL_ENABLED=false
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password_here

# Telegram bot (create via @BotFather, get chat_id from @userinfobot)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Checker behaviour ───────────────────────────────────────────────────────────

# How many months ahead to scan (SANParks opens bookings ~11 months ahead)
MONTHS_TO_CHECK=11

# Run in headless mode (true = no browser window, false = visible for debugging)
HEADLESS=true

# Path to store availability state between runs
STATE_FILE=state.json

# Send a Telegram status message on EVERY run (true = testing mode, false = normal).
# When true: shows current availability each run, flags new slots if any appeared.
# When false: only sends a notification when slots actually change.
STATUS_NOTIFY=false
